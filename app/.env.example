# litkit 环境变量示例（FR-CONFIG-03）
# 复制为 .env 并按需填写；.env 不入库（NFR-SEC-02）

# --- 工作目录与配置 ---
# 统一工作目录：.litkit/litkit.db / 输出文件默认在此；删除工作目录即删除文献库（无 TTL）
# LITKIT_WORK_DIR=/path/to/workdir
# 显式 .env 路径（默认按 WORK_DIR > CWD > 项目根 查找）
# LITKIT_ENV_FILE=/path/to/.env
# 默认写作语言模式（zh | en），默认 zh
# LITKIT_LANG=zh

# --- HTTP 客户端 ---
# 单请求超时（毫秒），默认 15000
# LITKIT_HTTP_TIMEOUT_MS=15000
# 429/5xx 重试次数，默认 2
# LITKIT_HTTP_RETRIES=2
# 显式代理（http/https/socks5，如本机 Clash：http://127.0.0.1:7890）。
# 设置后所有外呼（检索源/元数据反查/全文获取/LLM 评分）统一走代理；
# 不设置则直连，且仍尊重标准 HTTPS_PROXY/HTTP_PROXY/NO_PROXY 环境变量。
# 注意：自托管内网 endpoint（如内网 LLM）会经代理转发，请确认代理放行内网地址。
# LITKIT_PROXY_URL=http://127.0.0.1:7890

# --- 检索 ---
# 每源默认检索条数，默认 5
# LITKIT_DEFAULT_MAX_RESULTS=5
# 默认检索时间范围（最近 N 年），默认 3；0=不限
# LITKIT_DEFAULT_RECENT_YEARS=3
# 默认检索等级：tiab（题目+摘要+关键词，默认）| full（全文）
# LITKIT_DEFAULT_SEARCH_MODE=tiab

# --- 检索源 API key（可选）---
# Semantic Scholar 速率提升（无 key 走共享池，403 自动降级匿名）
# LITKIT_SEMANTIC_SCHOLAR_API_KEY=
# 二期源激活（IEEE/ACM，本期不实现）
# LITKIT_IEEE_API_KEY=
# LITKIT_ACM_API_KEY=

# --- LLM 引用评分（FR-LINT-08，可选）---
# 推荐直接在 .litkit/verifier_models.json 每模型 api_key/base_url 明文配置（该副本勿提交 git）。
# 启用条件：models[].enabled=true 且有 api_key（JSON 或 env 回落）即自动生效，无需总开关。
# 以下为 env 回落方式（JSON 未填 api_key/base_url 时生效）：
# 全局凭据（所有启用模型共用；设置了按模型变量时被其覆盖）
# LITKIT_LLM_API_KEY=sk-xxx
# LITKIT_LLM_BASE_URL=https://api.openai.com/v1
# 按模型凭据（命名约定：模型 id 大写、非字母数字转下划线；优先于全局）
# 例：deepseek-chat → 后缀 DEEPSEEK_CHAT；qwen-plus → QWEN_PLUS
# LITKIT_LLM_API_KEY_DEEPSEEK_CHAT=sk-xxx
# LITKIT_LLM_BASE_URL_DEEPSEEK_CHAT=https://api.deepseek.com/v1
# LITKIT_LLM_API_KEY_QWEN_PLUS=sk-xxx
# LITKIT_LLM_BASE_URL_QWEN_PLUS=https://dashscope.aliyuncs.com/compatible-mode/v1
# 单次评分超时（毫秒），默认 30000
# LITKIT_LLM_TIMEOUT_MS=30000

# --- 全文获取（FR-FETCH，可选）---
# Unpaywall OA 解析必需（https://unpaywall.org/products/api 免费申请）
# LITKIT_UNPAYWALL_EMAIL=you@example.com
# Sci-Hub 兜底镜像（默认 https://sci-hub.se，镜像经常变换可能失效）
# LITKIT_SCI_HUB_URL=https://sci-hub.se
# 全文 PDF 落盘目录（默认 <LITKIT_WORK_DIR>/downloads）
# LITKIT_FETCH_DOWNLOAD_DIR=
