# litkit 环境变量示例（FR-CONFIG-03）
# 复制为 .env 并按需填写；.env 不入库（NFR-SEC-02）

# --- 工作目录与配置 ---
# 统一工作目录：.litkit/litkit.db / 输出文件默认在此；删除工作目录即删除文献库（无 TTL）
# LITKIT_WORK_DIR=/path/to/workdir
# 显式 .env 路径（默认按 WORK_DIR > CWD > 项目根 查找）
# LITKIT_ENV_FILE=/path/to/.env
# 默认写作语言模式（zh | en），默认 zh
# LITKIT_LANG=zh

# --- HTTP 客户端 ---
# 单请求超时（毫秒），默认 15000
# LITKIT_HTTP_TIMEOUT_MS=15000
# 429/5xx 重试次数，默认 2
# LITKIT_HTTP_RETRIES=2

# --- 检索 ---
# 每源默认检索条数，默认 5
# LITKIT_DEFAULT_MAX_RESULTS=5
# 默认检索时间范围（最近 N 年），默认 3；0=不限
# LITKIT_DEFAULT_RECENT_YEARS=3
# 默认检索等级：tiab（题目+摘要+关键词，默认）| full（全文）
# LITKIT_DEFAULT_SEARCH_MODE=tiab

# --- 检索源 API key（可选）---
# Semantic Scholar 速率提升（无 key 走共享池，403 自动降级匿名）
# LITKIT_SEMANTIC_SCHOLAR_API_KEY=
# 二期源激活（IEEE/ACM，本期不实现）
# LITKIT_IEEE_API_KEY=
# LITKIT_ACM_API_KEY=

# --- 全文获取（FR-FETCH，可选）---
# Unpaywall OA 解析必需（https://unpaywall.org/products/api 免费申请）
# LITKIT_UNPAYWALL_EMAIL=you@example.com
# Sci-Hub 兜底镜像（默认 https://sci-hub.se，镜像经常变换可能失效）
# LITKIT_SCI_HUB_URL=https://sci-hub.se
# 全文 PDF 落盘目录（默认 <LITKIT_WORK_DIR>/downloads）
# LITKIT_FETCH_DOWNLOAD_DIR=

# --- 本地文献库语义检索（二期，FR-LIB-05）---
# embedding 提供方：local（默认，零 key 零网络）| api
# LITKIT_EMBEDDING_PROVIDER=local
# api 模式必需（阿里百炼 / 硅基流动 embedding key）
# LITKIT_EMBEDDING_API_KEY=
