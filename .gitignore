# 密钥与本地配置
.env
.env.*
!.env.example

# 运行时数据（本地文献库，无独立缓存层）
litkit.db
*.db
*.db-shm
*.db-wal

# 测试工作目录（spec 固化：e:\Codes\litkit\workspace）
workspace/

# 构建产物（go build -o 输出于 app/）
/litkit
/litkit.exe
app/litkit
app/litkit.exe
dist/

# 约束层构建产物（archcheck 由 go run 构建，不入库）
.harness/constraints/arch/archcheck.exe

# Python demo 产物（paper_toolkit_mcp 为参考 demo）
__pycache__/
*.pyc
*.pyo

# OS / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

paper_toolkit_mcp/